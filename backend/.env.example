# ─── App ───────────────────────────────────────────────
APP_NAME=PokeVault
ENVIRONMENT=development            # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
# Public origin of the deployed web app (Vercel). Used to build absolute URLs in
# /sitemap.xml so they point at the indexable SPA pages, not the API host. No trailing slash.
PUBLIC_WEB_ORIGIN=http://localhost:5173

# ─── Database (Supabase managed Postgres) ──────────────
# Get this from Supabase → Project Settings → Database → Connection string.
# Use the async driver (asyncpg). Replace ALL angle-bracket placeholders.
# Do NOT commit the filled-in value — put it in backend/.env (gitignored).
DATABASE_URL=postgresql+asyncpg://postgres:<YOUR-DB-PASSWORD>@<PROJECT-REF>.supabase.co:5432/postgres

# Alembic uses a sync driver for migrations; leave commented to reuse DATABASE_URL,
# or set an explicit sync URL here.
# ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:<YOUR-DB-PASSWORD>@<PROJECT-REF>.supabase.co:5432/postgres

# ─── pokemontcg.io (card catalog + pricing) ────────────
# Free API key from https://dev.pokemontcg.io/ — raises rate limits.
# Sent as the X-Api-Key header. The catalog is treated as the English catalog.
POKEMONTCG_API_KEY=<YOUR-POKEMONTCG-API-KEY>
# POKEMONTCG_API_BASE=https://api.pokemontcg.io/v2

# ─── Auth (Supabase) ───────────────────────────────────
# The backend VERIFIES Supabase-issued JWTs; it does not issue tokens. Only the
# project URL is needed — public signing keys are fetched from the JWKS endpoint
# ({SUPABASE_URL}/auth/v1/.well-known/jwks.json). No secret is stored server-side.
SUPABASE_URL=https://<PROJECT-REF>.supabase.co
# SUPABASE_JWT_AUD=authenticated   # default; override only if your project differs

# ─── CORS ──────────────────────────────────────────────
# Comma-separated origins allowed to call the API (the Vite dev server).
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
